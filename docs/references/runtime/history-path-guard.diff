         # 配信ルート外へのパストラバーサルを拒否
-        if (-not $path.StartsWith($root, [System.StringComparison]::OrdinalIgnoreCase) -or
+        if (-not $path.StartsWith($rootPrefix, [System.StringComparison]::OrdinalIgnoreCase) -or
